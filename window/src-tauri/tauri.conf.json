{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tsunu Pet",
  "version": "0.1.2",
  "identifier": "com.atone.tsunu-pet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "小阿宇",
        "width": 240,
        "height": 260,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../mod/.claude-plugin/plugin.json": "mod/.claude-plugin/plugin.json",
      "../../mod/hooks/": "mod/hooks/",
      "../../mod/assets/": "mod/assets/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
